{
  "name": "@scratch-code/materialize",
  "version": "0.1.0",
  "description": "Complete Scratch AST shadows and block IDs from block specs",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@scratch-code/ast": "workspace:^",
    "@scratch-code/block-spec": "workspace:^"
  },
  "devDependencies": {
    "@scratch-code/sb3": "workspace:^",
    "@scratch-code/scratchblocks-codec": "workspace:^",
    "@scratch-code/turbowarp-blocks": "workspace:^",
    "scratchblocks-plus": "^2.1.0"
  },
  "keywords": [
    "scratch",
    "ast",
    "shadow",
    "materialize"
  ]
}
