{
  "name": "@scratch-code/diff",
  "version": "0.1.0",
  "description": "Deterministic semantic diffs for Scratch AST scripts",
  "author": "Blockdia contributors",
  "homepage": "https://github.com/blockdia/scratch-code/tree/main/packages/diff#readme",
  "bugs": {
    "url": "https://github.com/blockdia/scratch-code/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockdia/scratch-code.git",
    "directory": "packages/diff"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@scratch-code/ast": "workspace:^"
  },
  "keywords": [
    "scratch",
    "ast",
    "diff"
  ]
