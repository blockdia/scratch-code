{
  "name": "scratch-code",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "build:playground": "pnpm --filter @scratch-code/playground build",
    "check": "pnpm format:check && pnpm lint && pnpm test:all",
    "dev:playground": "pnpm --filter @scratch-code/playground dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.integration.json",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --recursive test",
    "test:smoke": "pnpm --recursive --if-present run test:smoke",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:corpus": "node scripts/run-corpus.mjs",
    "test:all": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:smoke && pnpm test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@scratch-code/ast": "workspace:^",
    "@scratch-code/block-spec": "workspace:^",
    "@scratch-code/diff": "workspace:^",
    "@scratch-code/fragment": "workspace:^",
    "@scratch-code/materialize": "workspace:^",
    "@scratch-code/sb3": "workspace:^",
    "@scratch-code/scratchblocks-codec": "workspace:^",
    "@scratch-code/turbowarp-blocks": "workspace:^",
    "@scratch-code/vm-blocks": "workspace:^",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "scratchblocks-plus": "^2.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.0"
  }
}
